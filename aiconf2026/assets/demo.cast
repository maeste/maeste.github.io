 via CLI, or validate a change in the QuickNote pro\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[6G\u001b[22mject.\"\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G4\u001b[6G\u001b[22margument-hint:\u001b[21G\"[test|lint|format|add-note\u001b[49G<title>]\"\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G5\u001b[6G\u001b[22mallowed-tools:\u001b[21GBash(pytest:*)\u001b[36GBash(ruff:*)\u001b[49GBash(quicknote:*)\u001b[67GBash(pip:*)\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G6\u001b[6G\u001b[22m---\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G7\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G8\u001b[6G\u001b[22m#\u001b[8GQuickNote\u001b[18GDev\u001b[22GSkill\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G9\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 10\u001b[6G\u001b[22mQuick\u001b[12Gaccess\u001b[19Gto\u001b[22Gcommon\u001b[29Gdevelopment\u001b[41Goperations\u001b[52Gin\u001b[55Gthe\u001b[59GQuickNote\u001b[69Gproject.\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 11\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 12\u001b[6G\u001b[22m##\u001b[9GUsage\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 13\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 14\u001b[6G\u001b[22m```\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 15\u001b[6G\u001b[22m/quicknote-dev\u001b[21Gtest\u001b[35G#\u001b[37Grun\u001b[41Gfull\u001b[46Gtest\u001b[51Gsuite\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 16\u001b[6G\u001b[22m/quicknote-dev\u001b[21Glint\u001b[35G#\u001b[37Gruff\u001b[42Gcheck\u001b[48G+\u001b[50Gformat\u001b[57Gcheck\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 17\u001b[6G\u001b[22m/quicknote-dev\u001b[21Gformat\u001b[35G#\u001b[37Gapply\u001b[43Gruff\u001b[48Gformat\u001b[55G+\u001b[57Gfix\u001b[39m\r\r\n