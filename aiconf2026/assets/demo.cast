1b[38;2;248;248;242m\u001b[2m \u001b[4G3\u001b[6G\u001b[22m \u001b[10G\u001b[38;2;230;219;116m\"context7\"\u001b[38;2;248;248;242m:\u001b[22G{\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G4\u001b[6G\u001b[22m \u001b[12G\u001b[38;2;230;219;116m\"command\"\u001b[38;2;248;248;242m:\u001b[23G\u001b[38;2;230;219;116m\"npx\"\u001b[38;2;248;248;242m,\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G5\u001b[6G\u001b[22m \u001b[12G\u001b[38;2;230;219;116m\"args\"\u001b[38;2;248;248;242m:\u001b[20G[\u001b[38;2;230;219;116m\"-y\"\u001b[38;2;248;248;242m,\u001b[27G\u001b[38;2;230;219;116m\"@upstash/context7-mcp\"\u001b[38;2;248;248;242m],\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G6\u001b[6G\u001b[22m \u001b[12G\u001b[38;2;230;219;116m\"note\"\u001b[38;2;248;248;242m:\u001b[20G\u001b[38;2;230;219;116m\"Documentation\u001b[35Glookup\u001b[42Gfor\u001b[46GPython,\u001b[54GClick,\u001b[61Gpytest.\u001b[69GInstall:\u001b[78Gnpx\u001b[82G@upstash/context7-mcp\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[6G\u001b[22m\u001b[38;2;230;219;116m\"\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G7\u001b[6G\u001b[22m \u001b[10G},\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G8\u001b[6G\u001b[22m \u001b[10G\u001b[38;2;230;219;116m\"serena\"\u001b[38;2;248;248;242m:\u001b[20G{\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[4G9\u001b[6G\u001b[22m \u001b[12G\u001b[38;2;230;219;116m\"command\"\u001b[38;2;248;248;242m:\u001b[23G\u001b[38;2;230;219;116m\"uvx\"\u001b[38;2;248;248;242m,\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 10\u001b[6G\u001b[22m \u001b[12G\u001b[38;2;230;219;116m\"args\"\u001b[38;2;248;248;242m:\u001b[20G[\u001b[38;2;230;219;116m\"--from\"\u001b[38;2;248;248;242m,\u001b[31G\u001b[38;2;230;219;116m\"git+https://github.com/oraios/serena\"\u001b[38;2;248;248;242m,\u001b[71G\u001b[38;2;230;219;116m\"serena\"\u001b[38;2;248;248;242m,\u001b[81G\u001b[38;2;230;219;116m\"start-mcp-server\"\u001b[38;2;248;248;242m,\u001b[101G\u001b[38;2;230;219;116m\"-\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[6G\u001b[22m\u001b[38;2;230;219;116m-project-root\"\u001b[38;2;248;248;242m,\u001b[22G\u001b[38;2;230;219;116m\".\"\u001b[38;2;248;248;242m],\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 11\u001b[6G\u001b[22m \u001b[12G\u001b[38;2;230;219;116m\"note\"\u001b[38;2;248;248;242m:\u001b[20G\u001b[38;2;230;219;116m\"Semantic\u001b[30Gcode\u001b[35Gnavigation\u001b[46G(LSP).\u001b[53GRequires\u001b[62Guvx.\u001b[67GWires\u001b[73Gsymbol\u001b[80Glookup,\u001b[88Gfind-references\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[6G\u001b[22m\u001b[38;2;230;219;116m,\u001b[8Grename.\"\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 12\u001b[6G\u001b[22m \u001b[10G}\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 13\u001b[6G\u001b[22m \u001b[8G},\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 14\u001b[6G\u001b[22m \u001b[8G\u001b[38;2;230;219;116m\"_portability_note\"\u001b[38;2;248;248;242m:\u001b[29G\u001b[38;2;230;219;116m\"Server\u001b[37Gpaths\u001b[43Gabove\u001b[49Gwork\u001b[54Gfor\u001b[58GClaude\u001b[65GCode.\u001b[71GOther\u001b[77Gagents\u001b[84Gmay\u001b[88Gneed\u001b[93Gvendor-spe\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m \u001b[6G\u001b[22m\u001b[38;2;230;219;116mcific\u001b[12Gconfig\u001b[19Gwrappers.\"\u001b[39m\r\r\n\u001b[2G\u001b[38;2;248;248;242m\u001b[2m 15\u001b[6G\u001b[22m}\u001b[39m\r\r\n\u001b[38;2;80;80;80m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254